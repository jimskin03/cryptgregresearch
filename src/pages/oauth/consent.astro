---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Connect to Bookmarks" description="Continue to Bookmarks to review an OAuth connection request.">
  <section class="page-intro">
    <div class="container">
      <div class="eyebrow">BOOKMARKS OAUTH</div>
      <h1>Connect to Bookmarks</h1>
      <p id="consent-status">Opening the Bookmarks authorization screen…</p>
      <p class="muted">You will review the application and its requested access before approving anything.</p>
      <noscript>JavaScript is required to continue to the Bookmarks authorization screen.</noscript>
    </div>
  </section>
</BaseLayout>

<script>
  import { initOAuthConsent } from '@/scripts/oauth-consent';
  initOAuthConsent();
</script>
