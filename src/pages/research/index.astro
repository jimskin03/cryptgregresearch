---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('research')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Research"><section class="page-intro"><div class="container"><div class="eyebrow">PUBLICATIONS / INDEX</div><h1>Research</h1><p>Investigations, experiments, and analyses published with their project context and dataset references intact.</p></div></section><section class="section"><div class="container"><div class="data-panel"><div class="eyebrow">WEEKLY SERIES</div><h3 style="margin-top:.6rem"><a href="/research/weekly">Weekly observations →</a></h3><p class="card-copy" style="margin-bottom:0">A dated weekly record of what the public systems actually did, separated into Observed, Interpreted, and Uncertain — each external claim linked to a cited, dated source and released only after an independent source-gate review. <a href="/api/observations.json">/api/observations.json</a></p></div></div></section><section class="section"><div class="container"><div class="grid grid-2">{entries.map((entry) => <ResearchCard entry={entry} />)}</div></div></section></BaseLayout>
