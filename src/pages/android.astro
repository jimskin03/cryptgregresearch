---
import '@/styles/legacy-home.css';
const apps = [
  { id: 'friendly', name: 'Friendly', category: 'Productivity', symbol: '✦', tagline: 'Your personal digital Catsistant.', description: 'A friendly companion for your everyday ideas, questions, and plans. Bring your conversations and tools together in one Android app.', features: ['Chat with your AI assistant', 'Organise conversations in folders', 'Plan, summarise, look up, and brainstorm', 'Personalise your experience with kitty companions'], subject: 'Friendly closed testing access' },
  { id: 'spend-wise', name: 'Spend Wise', category: 'Finance', symbol: '↗', tagline: 'A clearer picture of your money.', description: 'A spending and wealth tracker that brings your income, expenses, and recurring commitments into focus.', features: ['Track income and expenses', 'Explore spending by category', 'Manage recurring bills and commitments', 'Model wealth growth and debt repayment'], subject: 'Spend Wise closed testing access' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Meet Friendly and Spend Wise, two Android apps by Cryptgreg Research. Request access to closed testing." />
    <link rel="canonical" href="https://android.cryptgregresearch.org/" />
    <title>Android — Friendly & Spend Wise · Cryptgreg Research</title>
  </head>
  <body>
    <a class="skip" href="#apps">Skip to apps</a>
    <nav aria-label="Primary navigation"><div class="wrap navin"><a class="android-brand" href="https://cryptgregresearch.org/"><b>CRYPT</b>GREG RESEARCH</a><a class="back" href="https://cryptgregresearch.org/">← MAIN SITE</a></div></nav>
    <main class="wrap">
      <header class="android-hero">
        <div class="eyebrow">Cryptgreg Research / Android</div>
        <h1>Small apps.<br /><em>Everyday possibilities.</em></h1>
        <p>Meet Friendly and Spend Wise. A companion for your ideas, and a clearer view of your finances — built for Android.</p>
        <a class="btn" href="#apps">EXPLORE THE APPS ↓</a>
        <div class="release-note"><span class="signal"></span> Two apps · Early Access · Closed testing</div>
      </header>
      <section id="apps" aria-labelledby="apps-title">
        <div class="sectionhead"><div><div class="eyebrow">Made for your everyday</div><h2 id="apps-title">Two apps. Your next step.</h2></div><div class="sectionnum">ANDROID / 01—02</div></div>
        <div class="app-grid">{apps.map((app, index) => <article class:list={['app-card', app.id]} aria-labelledby={`${app.id}-title`}>
          <div class="app-top"><span class="app-icon" aria-hidden="true">{app.symbol}</span><span class="app-number">0{index + 1} / {app.category}</span></div>
          <span class="status LIVE">EARLY ACCESS</span>
          <h2 id={`${app.id}-title`}>{app.name}</h2><h3>{app.tagline}</h3><p>{app.description}</p>
          <ul>{app.features.map((feature) => <li>{feature}</li>)}</ul>
          <a class="btn access" href={`mailto:info@cryptgregresearch.org?subject=${encodeURIComponent(app.subject)}&body=${encodeURIComponent(`Hi Cryptgreg Research,\n\nI'd like to join closed testing for ${app.name}.\nMy Google Play email address is: \n\nThank you!`)}`}>REQUEST TESTING ACCESS ↗</a>
          <p class="testing-note">Invitation required · Google Play closed testing</p>
        </article>)}</div>
      </section>
      <section class="testing" aria-labelledby="testing-title"><div><div class="eyebrow">Try it early / help shape what’s next</div><h2 id="testing-title">Join the testing circle.</h2><p>Both apps are currently in closed testing. Email us with the app you’d like to try and the email address you use for Google Play. Access is by invitation; we’ll reply with the next steps.</p></div><a class="btn" href="mailto:info@cryptgregresearch.org?subject=Android%20closed%20testing">GET IN TOUCH ↗</a></section>
    </main>
    <footer>© Cryptgreg Research · <a href="https://cryptgregresearch.org/">Research hub</a> · <a href="https://cryptgregresearch.org/terms">Terms &amp; Conditions</a> · <a href="mailto:info@cryptgregresearch.org">Contact</a></footer>
  </body>
</html>
<style>
  .android-brand{font:13px var(--mono);letter-spacing:1px;margin:0;color:var(--display)}.android-brand b{color:var(--cyan)}.skip{position:absolute;left:20px;top:-100px;background:var(--panel);padding:12px;z-index:10}.skip:focus{top:10px}a:focus-visible{outline:2px solid var(--cyan);outline-offset:5px}.android-hero{padding:100px 0 70px;max-width:850px}.android-hero h1{font:600 clamp(42px,7vw,76px)/1.08 var(--serif);letter-spacing:-2px;margin:24px 0;color:var(--display)}.android-hero em{color:var(--cyan)}.android-hero p{max-width:600px;font-size:19px;color:#a7b8be;margin-bottom:32px}.android-hero .btn{display:inline-block}.release-note{margin-top:30px;font:12px var(--mono);color:#a7b8be}.signal{display:inline-block;width:7px;height:7px;background:var(--cyan);border-radius:50%;margin-right:8px}.app-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.app-card{border:1px solid var(--line);background:var(--card);border-radius:16px;padding:34px;display:flex;align-items:start;flex-direction:column}.friendly{background:radial-gradient(ellipse at top left,#e8b44a14,transparent 65%),var(--card)}.spend-wise{background:radial-gradient(ellipse at top left,#38e1d614,transparent 65%),var(--card)}.app-top{display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:28px;gap:16px}.app-icon{display:grid;place-items:center;width:76px;height:76px;border-radius:20px;color:#f5c56f;background:#392a15;border:1px solid #e8b44a66;font-size:44px}.spend-wise .app-icon{background:#15372d;border-color:#38e1d666;color:var(--cyan)}.app-number{font:11px var(--mono);color:#a7b8be}.app-card h2{font-size:38px;margin-top:20px}.app-card h3{font:20px var(--serif);color:var(--display);margin:12px 0}.app-card p{color:#a7b8be;margin:0}.app-card ul{padding-left:20px;color:#a7b8be;margin:26px 0 32px}.app-card li{padding:5px 0}.app-card li::marker{color:var(--cyan)}.access{margin-top:auto;display:inline-block;line-height:1.5}.app-card .testing-note{font:11px/1.6 var(--mono);margin-top:15px}.testing{display:flex;align-items:center;gap:50px;justify-content:space-between}.testing p{max-width:660px;color:#a7b8be}.testing .btn{white-space:nowrap}@media(max-width:780px){nav .back{display:inline;font-size:10px;margin-left:12px}.android-brand{font-size:10px;letter-spacing:.5px}.android-hero{padding:65px 0 50px}.app-grid{grid-template-columns:1fr}.app-card{padding:26px}.testing{display:block}.testing .btn{display:inline-block;margin-top:18px}.release-note{font-size:10px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
