<BaseLayout title="Terms & Conditions" description="Terms for Cryptgreg Research websites, Android apps, research, and experimental services, including acceptable use and limitations of liability.">
  <section class="page-intro">
    <div class="container">
      <div class="eyebrow">LEGAL / TERMS OF USE</div>
      <h1>Terms &amp; Conditions</h1>
      <p>These terms describe the conditions for using Cryptgreg Research and the limits of our services. Please read them before using an account, app, or experimental feature.</p>
