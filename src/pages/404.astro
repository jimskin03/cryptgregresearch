---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for does not exist on Cryptgreg Research." noindex>
  <section class="page-intro">
    <div class="container">
      <div class="eyebrow">ERROR / 404</div>
      <h1>Page not found</h1>
      <p>This address does not match any page on Cryptgreg Research. It may have moved, or the link may be mistyped.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">GO TO THE HOMEPAGE →</a>
        <a class="button" href="/research/">READ THE RESEARCH</a>
        <a class="button" href="/projects/">BROWSE PROJECTS</a>
      </div>
    </div>
  </section>
</BaseLayout>
