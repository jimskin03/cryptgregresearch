---
import { auditReceipts, landPlots, projectRegistryLastUpdated, projects, treasuryRows } from '@/data/records';
import '@/styles/legacy-home.css';

const mainProjects = projects.filter((project) => project.id !== 'beacon-relay');
const experiments = projects.filter((project) => project.id === 'beacon-relay');
const updated = projectRegistryLastUpdated.replace('T', ' ').replace('Z', ' UTC');
const displayStatus = (project: typeof projects[number]) => project.featured ? 'FEATURED' : project.id === 'beacon-relay' ? 'CONCEPT / IN DEVELOPMENT' : project.status;
const statusToken = (status: string) => status.startsWith('CONCEPT') ? 'CONCEPT' : status;
---
<nav><div class="wrap navin"><div class="brand"><b>CRYPT</b>GREG RESEARCH</div><div><a href="#projects">PROJECTS</a><a href="#treasury">TREASURY</a><a href="#land">LAND</a><a href="#receipts">RECEIPTS</a><span id="auth-area" class="auth"><button id="auth-open" data-auth-open type="button">SIGN IN</button></span><i class="dot"></i></div></div></nav>
<main class="wrap">
<header class="hero"><div><div class="eyebrow">Independent research · on-chain evidence</div><h1>Research you can <em>audit.</em></h1><p>Cryptgreg Research builds, studies, and documents digital projects in the open — from practical tools to experimental worlds. Eastern Paradise is our flagship simulation, not the whole story.</p><div class="actions"><a class="btn" href="#projects">EXPLORE PROJECTS</a><a class="btn" href="#receipts">READ THE EVIDENCE</a></div></div><div class="orbital" aria-label="Abstract research network graphic"><span class="node"></span><span class="label">CRG / NETWORK MAP — 01</span></div></header>
<section id="projects"><div class="sectionhead"><div><div class="eyebrow">Selected work · 01</div><h2>Projects with a pulse</h2></div><div class="sectionnum"><a href="/projects.json">/projects.json · DATA INDEX</a></div></div><div id="project-grid" class="projects" aria-live="polite">{mainProjects.map((project) => <article class:list={['project', project.id === 'eastern-paradise' && 'featured']} id={`project-${project.id}`} data-project-id={project.id} data-status={displayStatus(project)} data-status-checked-at={project.statusCheckedAt ?? projectRegistryLastUpdated}><div><span class={`status ${statusToken(displayStatus(project))}`}>{displayStatus(project)}</span></div><h3>{project.name}</h3><p>{project.description}</p>{project.verificationNote && <p class="disc">{project.verificationNote}</p>}<a href={project.externalUrl} target="_blank" rel="noopener noreferrer">OPEN PROJECT ↗</a></article>)}</div></section>
<section id="experiments"><div class="sectionhead"><div><div class="eyebrow">Research & experiments · 02</div><h2>Still becoming</h2></div><div class="sectionnum"><a href="/research.json">/research.json · DATA INDEX</a></div></div><div id="experiment-grid" class="projects research" aria-live="polite">{experiments.map((project) => <article class="project" id={`project-${project.id}`} data-project-id={project.id} data-status={displayStatus(project)} data-status-checked-at={project.statusCheckedAt ?? projectRegistryLastUpdated}><div><span class={`status ${statusToken(displayStatus(project))}`}>{displayStatus(project)}</span></div><h3>{project.name}</h3><p>{project.description}</p>{project.verificationNote && <p class="disc">{project.verificationNote}</p>}<a href={project.externalUrl} target="_blank" rel="noopener noreferrer">OPEN PROJECT ↗</a></article>)}</div></section>
<section id="paradise"><div class="sectionhead"><div><div class="eyebrow">Featured project · Eastern Paradise</div><h2>A sanctuary economy, <em class="cyan">kept honest in the open.</em></h2></div><div class="sectionnum">SOLANA / READ-ONLY</div></div><p>Every balance, plot, and policy decision links back to its source. The project ledger below is evidence-led and deliberately conservative.</p></section>
<section id="treasury"><div class="sectionhead"><div><div class="eyebrow">Eastern Paradise ledger · 03</div><h2>The treasury, as it stands</h2></div><div class="sectionnum">READ-ONLY / NO WALLET</div></div><div class="evidence"><div class="evidencehead"><span>TREASURY.SCAN // SIGNAL</span><span>last_updated: {updated}</span></div><div class="rows">{treasuryRows.map((row) => <div class="row"><span>{row.label.toLowerCase()}</span><strong>{row.value} <span class:list={['status', row.status]}>{row.status}</span></strong></div>)}</div><p class="disc">On-chain figures are unaudited. Values remain placeholders until linked to verified sources. No wallet connection or write path is exposed on this domain.</p></div></section>
<section id="land"><div class="sectionhead"><div><div class="eyebrow">Land registry · 04</div><h2>The land, plot by plot</h2></div><div class="sectionnum">SOLANA / EVIDENCE LINKS</div></div><div class="land">{landPlots.map((plot, index) => <article class="plot"><div class:list={['map', ['one', 'two', 'three'][index]]}></div><div class="plotbody"><h3>{plot.id}</h3><p><span class:list={['plot-status', plot.status.toLowerCase()]}>{plot.status}</span> · {plot.description.toLowerCase()} · tx evidence pending</p></div></article>)}</div></section>
<section id="receipts"><div class="sectionhead"><div><div class="eyebrow">Audit trail · 05</div><h2>Proof over assertion</h2></div></div><div class="receipts">{auditReceipts.map((receipt) => <article class="receipt"><b>{receipt.label}</b><p>{receipt.description}</p></article>)}</div></section>
<section id="contact"><div class="sectionhead"><div><div class="eyebrow">Human-directed · role-based</div><h2>The Axis</h2></div></div><div class="axis"><div><b>A.IRa</b>Administration · Governance</div><div><b>A.IXin</b>Infrastructure · Reliability</div><div><b>A.IStar</b>Treasury · Controls</div><div><b>A.INova</b>Design · Brand · Public Relations</div><div><b>A.IRis</b>Research · Verification</div></div><p class="contact-line">Contact A.INova · &gt;<a href="mailto:cryptgregresearch@agentmail.to"> · cryptgregresearch@agentmail.to</a></p></section>
</main><footer>© Cryptgreg Research · Authored by Khairum · figures are placeholders pending source verification</footer><footer><a href="/privacy">Privacy Policy</a> · <a href="#contact">Contact A.INova</a></footer>
<script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: 'Cryptgreg Research', url: 'https://cryptgregresearch.org/', description: 'Independent research and on-chain evidence.' })}></script>