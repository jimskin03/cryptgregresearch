---
// Shared <head> metadata: description, canonical, Open Graph, Twitter card, icons.
// Every page layout (and any standalone page) should render this once.
import { site } from '@/data/site';

interface Props {
  /** Full document title, e.g. "Projects — Cryptgreg Research". */
  title: string;
  description?: string;
  /** Absolute URL or site-relative path to a share image (ideally 1200x630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Override the self-referencing canonical (absolute URL). */
  canonical?: string;
  /** Adds noindex and omits the canonical (used by the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  imageAlt = `${site.name} — Analyze. Adapt. Improve. Together.`,
  type = 'website',
  noindex = false,
} = Astro.props;

const base = Astro.site ?? new URL(site.url);
const withSlash = (path: string) => (path.endsWith('/') || /\.[a-z0-9]+$/i.test(path) ? path : `${path}/`);
const canonicalUrl = Astro.props.canonical ?? new URL(withSlash(Astro.url.pathname), base).href;
const imageUrl = new URL(image, base).href;
const isDefaultImage = image === '/og-default.png';
---
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0A0F1A" />
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={imageUrl} />
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@cryptgreg" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
