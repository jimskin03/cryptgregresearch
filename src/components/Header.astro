---
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/"><span class="brand-mark">[●]</span><span>CRYPTGREG RESEARCH</span></a>
    <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">MENU</button>
    <nav class="nav" aria-label="Primary navigation">
      <a href="/research" aria-current={currentPath.startsWith('/research') ? 'page' : undefined}>Research</a>
      <a href="/projects" aria-current={currentPath.startsWith('/projects') ? 'page' : undefined}>Projects</a>
      <a href="/api/projects.json">API</a>
      <a href="/privacy" aria-current={currentPath === '/privacy' ? 'page' : undefined}>Privacy</a>
      <button class="button" data-auth-open type="button">Sign in</button>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', String(!open));
    toggle?.setAttribute('aria-expanded', String(!open));
  });
</script>
