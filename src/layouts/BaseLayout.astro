---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AuthDialog from '@/components/AuthDialog.astro';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/layout.css';
import '@/styles/components.css';
import SeoHead from '@/components/SeoHead.astro';
import { site } from '@/data/site';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; }
const { title = site.title, description = site.description, image, type, noindex } = Astro.props;
const fullTitle = `${title} — ${site.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="Tm8Xcc8QdoxI7I_5pDGOSsfVA6zRAnw7dWmLi-tWiV0" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <SeoHead title={fullTitle} description={description} image={image} type={type} noindex={noindex} />
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main><slot /></main>
      <Footer />
      <AuthDialog />
    </div>
  </body>
</html>
